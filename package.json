{
  "name": "puddle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dataset:build": "node --experimental-strip-types scripts/build-historical-dataset.ts",
    "model:train": "node --experimental-strip-types scripts/train-puddle-model.ts",
    "forecast:evaluate": "node --experimental-strip-types scripts/evaluate-puddle-forecasts.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "maplibre-gl": "^6.4.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
